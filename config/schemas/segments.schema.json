{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "segments.json",
  "type": "object",
  "required": ["videos"],
  "properties": {
    "videos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "title", "file", "duration"],
        "properties": {
          "key": {"type": "string", "pattern": "^[0-9]{2}_[a-z0-9]+$"},
          "title": {"type": "string"},
          "file": {"type": "string"},
          "duration": {"type": "number", "minimum": 0},
          "wiki": {"type": "string"}
        }
      }
    }
  }
}